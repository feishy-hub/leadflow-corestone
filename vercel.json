{
  "version": 2,
  "functions": {
    "api/claude.js": {
      "memory": 256,
      "maxDuration": 30
    },
    "api/data.js": {
      "memory": 256,
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/api/claude",
      "dest": "/api/claude.js"
    },
    {
      "src": "/api/data",
      "dest": "/api/data.js"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}